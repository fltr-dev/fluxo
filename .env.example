# Postgres (Neon: use a connection string "pooled")
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Auth.js — gere com: npx auth secret
AUTH_SECRET=

# Seu login (único com acesso aos dados reais). Use uma senha longa e aleatória.
OWNER_USER=
OWNER_PASSWORD=

# Demonstração (opcional): login para mostrar o sistema a outras pessoas, com dados fictícios fixos,
# somente leitura e sem acesso ao banco real. Não precisa de banco extra. Sem as duas variáveis, fica desligada.
DEMO_USER=
DEMO_PASSWORD=

# Pluggy (dashboard.pluggy.ai, aplicação com conector MeuPluggy ativo)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Vercel Cron envia "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Jev (opcional). Preencha UMA chave; sem nenhuma, a classificação por IA fica desligada.
#   AI_GATEWAY_API_KEY  Vercel → AI Gateway → API Keys (tem precedência)
#   TYPESAFE_API_KEY    console da TypeSafe
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=
JEV_ACCEPT_THRESHOLD=0.85
JEV_SUGGEST_THRESHOLD=0.6
